# Laravel API (Sanctum SPA auth, cookie + CSRF)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Must match Laravel's session cookie name/domain (proxy.ts + logout cleanup)
SESSION_COOKIE=laravel_session
SESSION_DOMAIN=

# Serve demo data from src/mocks instead of the Laravel API
NEXT_PUBLIC_API_MOCKS=true
